{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "本地窗口（设置页）的默认能力",
  "windows": ["settings"],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "dialog:default",
    "dialog:allow-open",
    "autostart:default",
    "process:default",
    "allow-get-config",
    "allow-set-config",
    "allow-choose-workspace",
    "allow-restart-service",
    "allow-quit-app",
    "allow-check-for-updates"
  ]
}
