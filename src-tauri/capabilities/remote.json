{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "remote",
  "description": "主窗口远程页面的最小能力（只读配置）；local=false 使该能力仅对远程 origin 生效，不波及主窗口加载本地页面（tauri://localhost）的瞬间",
  "windows": ["main"],
  "local": false,
  "remote": {
    "urls": ["http://127.0.0.1:*"]
  },
  "permissions": [
    "core:default",
    "allow-get-config"
  ]
}
